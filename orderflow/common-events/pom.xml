<?xml version="1.0" encoding="UTF-8"?>
<!--
  The ONLY thing the services share. It contains the event and command records that
  travel over Kafka, and nothing else: no entities, no repositories, no business logic.

  Why share this at all? Because an event is a contract. Keeping the record in one place
  makes the contract explicit and versioned. Everything else stays private to its service.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.orderflow</groupId>
    <artifactId>orderflow</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>common-events</artifactId>
  <name>common-events</name>
</project>
